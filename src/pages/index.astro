---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SiteHeader } from '../components/SiteHeader';
import { HeroSection } from '../components/HeroSection';
import {
  FIRST_DEMO_MOBILE_POSTER,
  FIRST_DEMO_POSTER,
  HERO_MOBILE_MEDIA,
  HERO_WIDE_MEDIA,
} from '../components/HeroVideoPreview';
import { ContactSection } from '../components/ContactSection';
import { SiteFooter } from '../components/SiteFooter';

const title = 'nila — Instagram 댓글 분석과 관리';
const description = 'Instagram 댓글을 분석해 먼저 살펴볼 댓글을 찾고, 검토와 처리 내역을 한곳에서 관리하세요.';
const canonicalUrl = 'https://nila.im/';
const shareImageUrl = new URL('/product-cards/01-ai-assistant.png', canonicalUrl).href;
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'nila',
  url: canonicalUrl,
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta name="naver-site-verification" content="be63f478fc77390cf8d6d6b8a87c2c0b62d22d92" />
    <link rel="preload" href={FIRST_DEMO_MOBILE_POSTER} as="image" type="image/webp" media={HERO_MOBILE_MEDIA} />
    <link rel="preload" href={FIRST_DEMO_POSTER} as="image" type="image/webp" media={HERO_WIDE_MEDIA} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="nila" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="댓글에 어떤 반응이 있는지 물어보세요. 닐라 AI 어시스턴트가 인스타그램 배송 불만을 배송 지연, 파손, 구성품 누락으로 나눠 보여주는 화면." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
  </Fragment>
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>
  <SiteHeader />
  <main id="main" class="landing-sections" tabindex="-1">
    <HeroSection client:load />
    <ContactSection />
  </main>
  <SiteFooter />
</BaseLayout>
