---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import heroProduct from '../assets/hero-product.png';
import heroPlaceholder from '../assets/hero-product-preview.webp?inline';
import { SiteHeader } from '../components/SiteHeader';
import { HeroSection } from '../components/HeroSection';
import { ScenariosSection } from '../components/ScenariosSection';
import { ContactSection } from '../components/ContactSection';
import { SiteFooter } from '../components/SiteFooter';

const heroSizes = '(min-width: 1296px) 1200px, (min-width: 1024px) calc(100vw - 96px), (min-width: 768px) calc(100vw - 64px), calc(100vw - 40px)';
const heroImage = await getImage({
  src: heroProduct,
  width: 1200,
  widths: [480, 768, 1200, 1920, 2400],
  sizes: heroSizes,
  format: 'webp',
  quality: 85,
});
---

<BaseLayout title="Nila — 댓글을 살피는 더 나은 흐름" description="Instagram 댓글 분석부터 검토와 처리 기록까지. Nila의 댓글 관리 흐름을 만나보세요.">
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>
  <SiteHeader />
  <main id="main" tabindex="-1">
    <HeroSection image={{
      src: heroImage.src,
      srcSet: heroImage.srcSet.attribute,
      sizes: heroSizes,
      width: 1200,
      height: 750,
      placeholder: heroPlaceholder,
    }} />
    <ScenariosSection />
    <ContactSection />
  </main>
  <SiteFooter />
</BaseLayout>
