---
import styles from './ScenariosSection.module.css';
import { SECTION_IDS } from '../constants/navigation';

const features = [
  { id: 'analysis', label: '댓글 분석', title: '확인이 필요한 댓글부터.', description: '댓글과 분석 결과를 함께 살펴보고, 검토가 필요한 댓글을 찾아보세요.' },
  { id: 'review', label: '검토와 처리', title: '판단부터 처리까지 한곳에서.', description: '검토할 댓글을 모아 살펴보고, 숨김·삭제 등 필요한 처리를 진행하세요.' },
  { id: 'history', label: '처리 기록', title: '지난 처리 내역도 다시 확인.', description: '전체·숨김 댓글과 삭제 기록을 확인하고, 이전 처리 내역을 살펴보세요.' },
];

const trackId = `${SECTION_IDS.features}-carousel`;
---

<section id={SECTION_IDS.features} class={styles.section} aria-label="주요 기능" data-feature-carousel>
    <div
      id={trackId}
      class={styles.viewport}
      role="group"
      aria-label="기능 카드"
      tabindex="0"
      data-carousel-viewport
    >
      <div class={styles.track} data-carousel-track>
      {features.map((feature) => (
        <article
          class:list={['card', styles.featureCard]}
          data-feature={feature.id}
        >
          <div class={styles.body}>
            <p class={styles.label}>{feature.label}</p>
            <h2>{feature.title}</h2>
            <p class={styles.description}>{feature.description}</p>
          </div>
        </article>
      ))}
      </div>
    </div>
  <div class="site-container">
    <div class={styles.controls} data-carousel-controls hidden>
      <button type="button" class:list={['btn btn-circle', styles.control]} aria-label="이전 기능" aria-controls={trackId} data-carousel-previous disabled>
        <span aria-hidden="true">←</span>
      </button>
      <button type="button" class:list={['btn btn-circle', styles.control]} aria-label="다음 기능" aria-controls={trackId} data-carousel-next>
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</section>

<script>
  import EmblaCarousel, { type EmblaCarouselType } from 'embla-carousel';
  import { WheelGesturesPlugin } from 'embla-carousel-wheel-gestures';

  document.querySelectorAll<HTMLElement>('[data-feature-carousel]').forEach((section) => {
    const viewport = section.querySelector<HTMLElement>('[data-carousel-viewport]');
    const controls = section.querySelector<HTMLElement>('[data-carousel-controls]');
    const previous = section.querySelector<HTMLButtonElement>('[data-carousel-previous]');
    const next = section.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!viewport || !controls || !previous || !next) return;

    const gridMedia = window.matchMedia('(min-width: 1280px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let carousel: EmblaCarouselType | undefined;

    const update = () => {
      previous.disabled = !carousel?.canScrollPrev();
      next.disabled = !carousel?.canScrollNext();
      controls.hidden = previous.disabled && next.disabled;
    };
    const refresh = () => {
      const slides = carousel?.slideNodes() ?? [];
      slides.forEach((slide, index) => {
        slide.setAttribute('role', 'group');
        slide.setAttribute('aria-roledescription', '슬라이드');
        slide.setAttribute('aria-label', `${index + 1} / ${slides.length}`);
      });
      update();
    };
    const goPrevious = () => carousel?.scrollPrev(reducedMotion.matches);
    const goNext = () => carousel?.scrollNext(reducedMotion.matches);
    const onKeydown = (event: KeyboardEvent) => {
      if (!carousel || event.target !== viewport || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      if (event.key === 'ArrowRight') goNext();
      else goPrevious();
    };
    const cleanup = () => {
      previous.removeEventListener('click', goPrevious);
      next.removeEventListener('click', goNext);
      viewport.removeEventListener('keydown', onKeydown);
      delete viewport.dataset.emblaReady;
      viewport.removeAttribute('aria-roledescription');
      viewport.querySelectorAll('article').forEach((slide) => {
        slide.removeAttribute('role');
        slide.removeAttribute('aria-roledescription');
        slide.removeAttribute('aria-label');
      });
      update();
    };
    const setMode = () => {
      if (gridMedia.matches) {
        const instance = carousel;
        carousel = undefined;
        instance?.destroy();
        cleanup();
        viewport.removeAttribute('tabindex');
        viewport.scrollLeft = 0;
        return;
      }
      if (carousel) return;

      viewport.setAttribute('tabindex', '0');
      // Apply the visible-overflow layout before Embla measures the cards.
      viewport.scrollLeft = 0;
      viewport.dataset.emblaReady = 'true';
      try {
        carousel = EmblaCarousel(viewport, {
          align: 'start',
          containScroll: 'trimSnaps',
          slidesToScroll: 1,
          loop: false,
          dragFree: false,
          watchSlides: true,
          watchResize: true,
          breakpoints: { '(prefers-reduced-motion: reduce)': { duration: 0 } },
        }, [WheelGesturesPlugin({ forceWheelAxis: 'x' })]);
        viewport.setAttribute('aria-roledescription', '캐러셀');
        previous.addEventListener('click', goPrevious);
        next.addEventListener('click', goNext);
        viewport.addEventListener('keydown', onKeydown);
        carousel.on('select', update);
        carousel.on('reInit', refresh);
        refresh();
      } catch (error) {
        const instance = carousel;
        carousel = undefined;
        instance?.destroy();
        cleanup();
        console.error('기능 캐러셀을 초기화하지 못했습니다.', error);
      }
    };

    gridMedia.addEventListener('change', setMode);
    setMode();
  });
</script>
